      "features": [
        {
          "zh": "聊天驱动 Agent：飞书/Lark 文本触发真实宿主任务，推理、工具和结果分开展示。",
          "en": "Chat-driven agents: Feishu/Lark messages launch host tasks with separate reasoning/tool/result views."
        },
        {
          "zh": "持久会话：按聊天、话题或发送者隔离，/new 新建，/sessions 续接。",
          "en": "Durable sessions: chat/thread/sender scopes, /new reset and /sessions continuation."
        },
        {
          "zh": "工作区和模型：/ws、/cd、/model 切换，/status 查看状态，/stop 停止。",
          "en": "Workspace/model controls: /ws, /cd, /model, /status and /stop."
        },
        {
          "zh": "交互卡片：回答模型问题、评审计划和批准工具；权限调整仍遵守批准者配置。",
          "en": "Interactive cards: questions, plan reviews and tool approvals subject to configured approvers."
        },
        {
          "zh": "多机器人：独立凭据与会话，botPeers 限制对话对象，botHops 限制循环。",
          "en": "Multiple bots: separate credentials/sessions, botPeers allowlists and botHops loop bounds."
        },
        {
          "zh": "文件传输：接收文件到工作区；群聊发送需要逐次批准，默认单文件 20 MiB。",
          "en": "File transfer: workspace inbox and per-send group approval, with a default 20 MiB per-file limit."
        }
      ],
      "config": [
        [
          "sessionScope",
          "see upstream schema",
          "chat / chat-thread / chat-sender"
        ],
        [
          "botHops",
          "6",
          "Maximum bot-to-bot hops / 机器人连续对话上限"
        ],
        [
          "attachImages",
          "false",
          "Enable only for vision models / 仅视觉模型启用"
        ],
        [
          "receiveFiles / sendFiles",
          "true",
          "Group sends require approval / 群聊发送仍需批准"
        ],
        [
          "maxReceiveFileBytes / maxSendFileBytes",
          "20 MiB",
          "Per-direction size limits / 双向单文件大小限制"
        ]
