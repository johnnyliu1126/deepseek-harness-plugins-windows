      "features": [
        {
          "zh": "状态自检与宿主证据：面板检查补丁和运行状态，失败读取不等于未安装。",
          "en": "Status diagnostics: inspect patch and host evidence; a read failure is not an absent installation."
        },
        {
          "zh": "提示词与规则：按预设管理文本、追加顺序、排除预设和一次性注入选项。",
          "en": "Prompt and rule management: per-preset text, ordering, exclusions, and one-shot injection controls."
        },
        {
          "zh": "补丁生命周期：本机备份、应用、回滚与版本管理；可能改写宿主，需单独操作。",
          "en": "Patch lifecycle: local backups, apply/revert and version management; host modification requires an explicit separate action."
        },
        {
          "zh": "演练台：附带预设、技能、SQLite 事实库和 /redteam/api 桥接。",
          "en": "Lab workbench: packaged presets, skills, SQLite evidence store and /redteam/api bridge."
        },
        {
          "zh": "重试与继续：配置自动重试、次数上限和继续文本；不保证任务一定成功。",
          "en": "Retry/continue: configurable retry limits and continuation text; success is not guaranteed."
        }
      ],
      "config": [
        [
          "autoApplyOnStart / autoUpdateOnStart",
          "false",
          "Explicit lifecycle controls / 显式生命周期控制"
        ],
        [
          "autoRetry / retryMax",
          "true / 3",
          "Retry controls / 重试"
        ],
        [
          "autoContinue / continueMax",
          "false / 3",
          "Continuation controls / 继续"
        ],
        [
          "postPrompt",
          "empty",
          "Local prompt text / 本地提示词"
        ]
      ],
